{
  "schema": "aib-plugin/v1",
  "name": "aib-skipstop",
  "version": "0.2.1",
  "summary": "Skip what need not run again, stop what is sure to fail, and keep the book of what that saved.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/lfu0327/aib-skipstop",
  "min_aib": "0.2.0-preview.8",
  "paid": false,
  "default": "on",
  "commands": [
    { "name": "aib-skipstop", "bin": "bin/aib-skipstop" }
  ],
  "reads": [
    { "what": "time saved, five boxes", "run": ["aib-skipstop", "saved", "--json"], "format": "aib-skipstop.saved/v1" }
  ]
}
